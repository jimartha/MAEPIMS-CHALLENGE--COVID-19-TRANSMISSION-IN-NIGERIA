# Extend the total_cases list to match 730 days (using interpolation)
total_cases = np.interp(np.arange(730), np.linspace(0, 729, num=len(total_cases)), total_cases)

# Create DataFrame
df = pd.DataFrame({"Date": dates, "Total Cases": total_cases.astype(int)})
df["Days"] = (df["Date"] - df["Date"].min()).dt.days  # Convert dates to numerical days

# SEIR-HVD Model with Fatigue, Vaccination, Hospitalization, and Death
def covid_model(t, y, beta0, lambda_f, sigma, gamma, delta, mu, nu):
    S, E, I, R, H, V, D = y
    N = S + E + I + R + H + V + D

    # Fatigue-dependent Transmission Rate
    beta_t = beta0 * (1 - np.tanh(lambda_f * t) / 2)

    # Equations
    dSdt = -beta_t * S * I / N - nu * S   # Susceptible decreases due to infection & vaccination
    dEdt = beta_t * S * I / N - sigma * E  # Exposed progresses to infected
    dIdt = sigma * E - gamma * I - delta * I  # Infected recovers, gets hospitalized, or dies
    dRdt = gamma * I  # Recovered
    dHdt = delta * I - mu * H  # Hospitalized patients recover or die
    dVdt = nu * S  # Vaccinated population
    dDdt = mu * H  # Deaths from hospitalization

    return [dSdt, dEdt, dIdt, dRdt, dHdt, dVdt, dDdt]

# Solve ODE
def solve_ode(params):
    beta0, lambda_f, sigma, gamma, delta, mu, nu = params
    y0 = [990000, 100, 50, 0, 0, 0, 0]  # Initial values (S, E, I, R, H, V, D)
    t_span = (0, df["Days"].max())
    t_eval = np.arange(df["Days"].max() + 1)
    sol = solve_ivp(covid_model, t_span, y0, args=(beta0, lambda_f, sigma, gamma, delta, mu, nu), t_eval=t_eval)
    return sol.t, sol.y

# Fit Model to Data (Using Least Squares)
def residuals(params):
    t_model, y_model = solve_ode(params)
    I_model = y_model[2]  # Extract the infected cases
    I_obs = df["Total Cases"].values
    I_model_interp = np.interp(df["Days"], t_model, I_model)
    return (I_obs - I_model_interp) / np.max(I_obs)  # Normalize residuals

# Initial parameter guesses
initial_params = [0.4, 0.03, 1/4, 0.12, 0.06, 0.015, 0.0008]  # (beta0, lambda_f, sigma, gamma, delta, mu, nu)

# Perform optimization
result = least_squares(residuals, initial_params, bounds=(0, np.inf))
optimized_params = result.x

# Solve with optimized parameters
t_model, y_model = solve_ode(optimized_params)
S, E, I, R, H, V, D = y_model

