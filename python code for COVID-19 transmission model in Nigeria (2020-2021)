import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
from scipy.integrate import solve_ivp

# Parameters
total_population = 1000000  # Total population
initial_exposed = 100        # Initial exposed individuals
initial_infected = 50        # Initial infected individuals
initial_recovered = 0        # Initial recovered individuals
initial_vaccinated = 0       # Initial vaccinated individuals
initial_dead = 0             # Initial dead individuals
initial_susceptible = total_population - (initial_exposed + initial_infected + initial_recovered + initial_vaccinated + initial_dead)

# Fatigue function for beta variation
def fatigue_effect(t, beta0, beta_max, fatigue_rate):
    return beta0 + (beta_max - beta0) * (1 - np.exp(-fatigue_rate * t))

# SEIR-HVD Model with Fatigue
def seir_hvd(t, y, beta0, beta_max, fatigue_rate, sigma, gamma, mu, delta_v, delta_d):
    S, E, I, R, V, D = y
    beta = fatigue_effect(t, beta0, beta_max, fatigue_rate)
    dSdt = -beta * S * I / total_population
    dEdt = beta * S * I / total_population - sigma * E
    dIdt = sigma * E - gamma * I - mu * I
    dRdt = gamma * I
    dVdt = delta_v * S
    dDdt = mu * I + delta_d * D
    return [dSdt, dEdt, dIdt, dRdt, dVdt, dDdt]

# Parameters for simulation
beta0 = 0.2       # Initial transmission rate
beta_max = 0.8    # Maximum transmission rate due to fatigue
fatigue_rate = 0.01 # Rate of increase in beta due to fatigue
sigma = 1/5       # Incubation rate (1/average incubation period)
gamma = 1/10      # Recovery rate (1/average infectious period)
mu = 0.005        # Death rate
delta_v = 0.002   # Vaccination rate
delta_d = 0.001   # Natural death rate

# Solve the system
t_span = (0, 365)  # Simulate for 1 year
t_eval = np.linspace(0, 365, 365)
initial_conditions = [initial_susceptible, initial_exposed, initial_infected, initial_recovered, initial_vaccinated, initial_dead]
sol = solve_ivp(seir_hvd, t_span, initial_conditions, args=(beta0, beta_max, fatigue_rate, sigma, gamma, mu, delta_v, delta_d), t_eval=t_eval)

# Plot results
plt.figure(figsize=(10,6))
plt.plot(t_eval, sol.y[2], label='Infected', color='red')
plt.plot(t_eval, sol.y[0], label='Susceptible', color='blue')
plt.plot(t_eval, sol.y[3], label='Recovered', color='green')
plt.plot(t_eval, sol.y[5], label='Deaths', color='black')
plt.axvline(x=np.argmax(sol.y[2]), linestyle='--', color='gray', label='Peak Infections')
plt.annotate('Fatigue-induced surge', xy=(np.argmax(sol.y[2]), max(sol.y[2])), 
             xytext=(np.argmax(sol.y[2])-50, max(sol.y[2])-5000), 
             arrowprops=dict(facecolor='black', arrowstyle='->'))
plt.xlabel('Days')
plt.ylabel('Population')
plt.title('Epidemic Dynamics with Fatigue-Induced Contact Rate')
plt.legend()
plt.show()
